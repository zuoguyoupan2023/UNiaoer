{
  "name": "uniaoer",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run traits:layers && run-p type-check \"build-only {@}\" -- && npm run check:dist-size",
    "build:pages": "node scripts/build-bank.mjs --concurrency 6 --max-minutes 15 && npm run build",
    "preview": "vite preview",
    "dev:birdid": "VITE_BIRDID_MODEL_BASE= vite --host --port 5174 --strictPort",
    "test": "vitest run",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "taxa": "node scripts/build-taxa.mjs",
    "bank": "node scripts/build-bank.mjs",
    "bank:taxa": "node scripts/build-bank.mjs --taxa",
    "xc:upgrade": "node scripts/xc-upgrade.mjs",
    "bank:dev": "node scripts/build-bank.mjs --limit 8",
    "bank:global": "node scripts/build-bank.mjs --global --media stage",
    "bank55": "node scripts/bank55-supervisor.mjs",
    "bank55:progress": "node scripts/bank55-progress.mjs",
    "bank:r2": "node scripts/build-bank.mjs --media r2",
    "bank:stage": "node scripts/build-bank.mjs --media stage",
    "bank:notes": "node scripts/apply-notes.mjs",
    "bank:profiles": "node scripts/apply-profiles.mjs",
    "r2:push": "node scripts/push-r2.mjs",
    "birdid:local": "node scripts/birdid-local-test.mjs",
    "layers": "node scripts/build-manifest-layers.mjs",
    "r2:manifest": "wrangler r2 object put uniaoerbucket/data/manifest.json --file=public/data/manifest.json --content-type \"application/json; charset=utf-8\" --cache-control \"public, max-age=300\" --remote",
    "check:bank": "node scripts/check-bank.mjs",
    "check:layers": "node scripts/check-manifest-layers.mjs",
    "check:meta": "node scripts/check-meta.mjs",
    "check:class": "node scripts/check-class.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "sync:prod": "node scripts/sync-prod.mjs",
    "check:sync": "node scripts/check-sync.mjs",
    "d1:usage": "node scripts/d1-usage.mjs",
    "quality:export": "node scripts/export-quality-exclusions.mjs",
    "check:media": "node scripts/check-media.mjs",
    "check:media-webkit": "node scripts/check-media-webkit.mjs",
    "check:staged": "node scripts/check-staged-media.mjs",
    "check:r2-magic": "node scripts/check-r2-media-magic.mjs",
    "fix:media-ext": "node scripts/repair-media-ext.mjs",
    "region:build": "node scripts/region/build-seasonality.mjs",
    "region:provinces": "node scripts/region/build-provinces.mjs",
    "region:records": "node scripts/region/build-country-records.mjs",
    "region:hotspots": "node scripts/region/build-hotspots.mjs",
    "region:hotspots-sql": "node scripts/region/build-hotspots-sql.mjs",
    "region:hotspots-gbif": "node scripts/region/build-hotspots-gbif.mjs",
    "region:distribution": "node scripts/region/build-distribution-global.mjs",
    "region:subdiv": "node scripts/region/fetch-subdivisions.mjs",
    "region:coverage": "node scripts/region/report-coverage.mjs",
    "region:gbif-sql": "node scripts/region/gbif-sql.mjs",
    "region:ebird": "node scripts/region/fetch-ebird.mjs",
    "region:nearby-spots": "node scripts/region/build-ebird-hotspots.mjs",
    "region:province-commonness": "node scripts/region/build-province-commonness.mjs",
    "region:review-commonness": "node scripts/region/review-province-commonness.mjs",
    "region:resolve-names": "node scripts/region/resolve-unmatched-names.mjs",
    "region:verify-provinces": "node scripts/region/verify-provinces.mjs",
    "region:verify-seasonality": "node scripts/region/verify-seasonality.mjs",
    "region:verify-hotspots": "node scripts/region/verify-hotspots.mjs",
    "check:region": "node scripts/check-region.mjs",
    "taxonomy:avilist": "node scripts/taxonomy/fetch-avilist.mjs",
    "taxonomy:wikidata-zh": "node scripts/taxonomy/fetch-wikidata-zh.mjs",
    "taxonomy:gbif-match": "node scripts/taxonomy/fetch-gbif-match.mjs",
    "taxonomy:iucn-habitat": "node scripts/taxonomy/fetch-iucn-habitat.mjs",
    "taxonomy:elton": "node scripts/taxonomy/match-elton-traits.mjs",
    "taxonomy:plumage": "node scripts/taxonomy/match-plumage-colours.mjs",
    "taxonomy:avonet": "node scripts/taxonomy/match-avonet-traits.mjs",
    "species-index": "node scripts/taxonomy/build-species-index.mjs",
    "check:index": "node scripts/check-species-index.mjs",
    "check:traits": "node scripts/check-traits.mjs",
    "verify:push": "run-s check:layers check:traits",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "traits:layers": "node scripts/apply-trait-layers.mjs",
    "taxonomy:habitat-en": "node scripts/taxonomy/fill-habitat-code-en.mjs",
    "field-marks": "node scripts/build-field-marks.mjs",
    "build:duyin": "node scripts/build-duyin-index.mjs",
    "check:duyin": "node scripts/build-duyin-index.mjs --check",
    "check:model-labels": "node scripts/check-model-labels.mjs",
    "worker:dev": "wrangler dev -c worker/wrangler.toml --remote",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml",
    "worker:check": "wrangler deploy -c worker/wrangler.toml --dry-run",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "gen:icons": "node scripts/gen-icon-paths.mjs",
    "d1:seed": "node scripts/gen-d1-seed.mjs",
    "d1:targeted": "node scripts/d1-targeted-sync.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/",
    "build:model-labels": "node scripts/build-model-label-map.mjs",
    "check:dist-size": "node scripts/check-dist-size.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "^0.577.0",
    "marked": "^15.0.12",
    "onnxruntime-web": "^1.30.0",
    "pinia": "^4.0.3",
    "qrcode-generator": "^2.0.4",
    "thumbhash": "^0.1.1",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "aws4fetch": "^1.0.20",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "fake-indexeddb": "^6.2.5",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "pinyin-pro": "^3.29.4",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
