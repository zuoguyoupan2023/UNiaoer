{
  "name": "uniaoer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:pages": "node scripts/build-bank.mjs --concurrency 6 --max-minutes 15 && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest",
    "bank": "node scripts/build-bank.mjs",
    "bank:dev": "node scripts/build-bank.mjs --limit 8",
    "bank:r2": "node scripts/build-bank.mjs --media r2",
    "bank:stage": "node scripts/build-bank.mjs --media stage",
    "r2:push": "node scripts/push-r2.mjs",
    "d1:seed": "node scripts/gen-d1-seed.mjs",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "pinia": "^4.0.3",
    "qrcode-generator": "^2.0.4",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "aws4fetch": "^1.0.20",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "fake-indexeddb": "^6.2.5",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
