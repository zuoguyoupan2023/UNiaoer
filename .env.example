# 复制为 .env 并填入你的密钥（.env 已被 .gitignore 忽略）

# Xeno-canto v3 个人 API Key（听音题音频源；不填则只用 iNaturalist sounds）
XC_API_KEY=

# IUCN Red List API v3 token（分布国家；免费注册 https://api.iucnredlist.org/）
# 不填则分布只用 GBIF 兜底
IUCN_API_KEY=

# ---- Cloudflare R2（--media r2 上传媒体时需要）----
# R2 S3 API 凭证：Cloudflare 控制台 → R2 → Manage R2 API Tokens 创建
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=uniaoer-media
# R2 公开访问地址（自定义域名优先；也可用 https://<bucket>.<account>.r2.dev）
R2_PUBLIC_BASE=
